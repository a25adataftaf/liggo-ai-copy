# Copia este archivo a `.env` y rellena la clave del proveedor.
# Sin clave, Liggo funciona igualmente en modo demo (motor local, sin IA).

# Cualquier proveedor compatible con la API de OpenAI (OpenAI, Groq, Together, OpenRouter…)
LIGGO_API_KEY=
LIGGO_BASE_URL=https://api.openai.com/v1
LIGGO_MODEL=gpt-4o-mini

# Alias aceptado por compatibilidad
# OPENAI_API_KEY=
